# Port and environment
PORT=3000
NODE_ENV=production

# Turso Cloud Database
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Session Secret
SESSION_SECRET=your_random_session_secret_here

# Password Encryption (AES-256-GCM 32-byte key)
PASSWORD_ENCRYPT_KEY=your_32_byte_secret_key_here

# ==============================================================================
# SMTP Email Configuration (For Real OTP Student Verification)
# ==============================================================================
# OPTION 1: Gmail App Password (Free 500 emails/day - Recommended)
# 1. Enable 2-Step Verification in Google Account (myaccount.google.com/security)
# 2. Go to "App Passwords" -> Create name "MatchSpace" -> Copy 16-letter password
SMTP_SERVICE=gmail
SMTP_USER=your_email@gmail.com
SMTP_PASS=abcdefghijklmnop
SMTP_FROM="MatchSpace Student Verification" <your_email@gmail.com>

# OPTION 2: HTTPS Mail API (Recommended for Cloud Containers e.g. Railway)
# Resend (resend.com - Free 3,000 emails/month via HTTPS Port 443)
RESEND_API_KEY=re_your_api_key_here
# RESEND_FROM="MatchSpace" <noreply@yourdomain.com>

# Brevo (brevo.com - Free 300 emails/day via HTTPS Port 443)
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here


